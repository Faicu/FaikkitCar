# Claude Remote Control pe server: câte o sesiune tmux pentru fiecare proiect.
# Instalare: cp deploy/claude-rc /usr/local/bin/ && cp deploy/claude.service /etc/systemd/system/
#            && systemctl daemon-reload && systemctl restart claude
# Atenție: restart-ul închide toate sesiunile Claude care rulează pe serverul tmux al serviciului.
[Unit]
Description=Claude Remote Control (faikkitbox + faikkitcar + faikkithome + faikkittiktok)
Wants=network-online.target
After=network-online.target

[Service]
Type=forking
User=root
WorkingDirectory=/root
ExecStart=/usr/bin/tmux new-session -d -s faikkitbox -x 200 -y 50 "/usr/local/bin/claude-rc /opt/faikkitbox faikkitbox"
ExecStartPost=/usr/bin/tmux new-session -d -s faikkitcar -x 200 -y 50 "/usr/local/bin/claude-rc /opt/faikkitcar faikkitcar"
ExecStartPost=/usr/bin/tmux new-session -d -s faikkithome -x 200 -y 50 "/usr/local/bin/claude-rc /opt/faikkithome faikkithome"
ExecStartPost=/usr/bin/tmux new-session -d -s faikkittiktok -x 200 -y 50 "/usr/local/bin/claude-rc /opt/faikkittiktok faikkittiktok"
ExecStop=/usr/bin/tmux kill-server
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
